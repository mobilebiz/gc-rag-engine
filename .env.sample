# ============================================================
#  Google Cloud / Gemini Enterprise Agent Platform
#  (旧称: Vertex AI Agent Builder / Discovery Engine)
#  API エンドポイントは discoveryengine.googleapis.com のまま
# ============================================================

# プロジェクトID (文字列, 例: my-project-v2)
PROJECT_ID=your-project-id-string
# プロジェクト番号 (数値, 例: 123456789012) — 検索 API のリソースパスに必要
PROJECT_NUMBER=your-numeric-project-number
# リージョン (通常は global)
LOCATION=global

# アプリ(エンジン)のID — Agent Platform コンソールで確認
AI_APPLICATION_ID=your-engine-id
# データストアID — 同期パイプラインの再取り込み先
DATA_STORE_ID=your-datastore-id

# ------------------------------------------------------------
#  Cloud Storage (最適化済みドキュメントの配置先)
# ------------------------------------------------------------
GCS_BUCKET=your-bucket-name
GCS_PREFIX=faq_docs

# ------------------------------------------------------------
#  Gemini API (ドキュメント最適化用 / Google AI Studio で取得)
#  検索 API 側では不要。deploy.sh は Cloud Run に渡しません。
#  ※ 旧名 API_KEY も引き続き読めますが GEMINI_API_KEY への移行を推奨
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# 任意: 使用モデル (既定 gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash
# 任意: 思考量 low / medium / high。空にするとモデル既定に委ねる (既定 low)
# GEMINI_THINKING_LEVEL=low
# 任意: 最適化の同時実行数 (既定 3)
# OPTIMIZE_CONCURRENCY=3
# 任意: レート制限時の最大リトライ回数 (既定 4)
# OPTIMIZE_MAX_RETRIES=4

# ------------------------------------------------------------
#  kintone (FAQ データソース)
# ------------------------------------------------------------
KINTONE_DOMAIN=example.cybozu.com
KINTONE_APP_ID=123
KINTONE_API_TOKEN=your-kintone-api-token
# ゲストスペース配下のアプリの場合のみ設定
KINTONE_GUEST_SPACE_ID=
# 任意: フィールドコードが question / answer 以外の場合に指定
# KINTONE_QUESTION_FIELD=question
# KINTONE_ANSWER_FIELD=answer

# ------------------------------------------------------------
#  検索・回答生成のチューニング (すべて任意)
# ------------------------------------------------------------
# 回答生成のプロンプト前置き (未設定ならモデル既定)
# SEARCH_PREAMBLE=音声での返答を想定するため、なるべく丁寧調で、かつ全体を200文字以内にまとめて回答してください。
# レスポンスに含める参照ドキュメント数 (既定 3)
# ANSWER_MAX_REFERENCES=3
# 検索の取得件数 (既定 10)
# SEARCH_PAGE_SIZE=10
# スモークテストのクエリ (未設定ならスキップ)
# SMOKE_TEST_QUERY=解約方法を教えて
# ログレベル debug / info / warn / error (既定 info)
# LOG_LEVEL=info

# ------------------------------------------------------------
#  Cloud Run デプロイ (すべて任意 / deploy.sh が参照)
# ------------------------------------------------------------
# CLOUD_RUN_SERVICE=rag-engine-service
# CLOUD_RUN_REGION=asia-northeast1
# CLOUD_RUN_SERVICE_ACCOUNT=rag-app-runner@your-project-id.iam.gserviceaccount.com
# 常時起動するインスタンス数 (既定 0)。
# 0 = コールドスタートあり・アイドル課金なし。1 にするとインスタンスベース課金になります。
# CLOUD_RUN_MIN_INSTANCES=0
