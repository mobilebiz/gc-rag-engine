{
  "info": {
    "name": "gc-rag-engine",
    "description": "kintone FAQ を Gemini Enterprise Agent Platform で検索する RAG エンジンの API テスト。\n\n使い方:\n1. 変数 `baseUrl` に Cloud Run のサービス URL を設定する\n2. 変数 `query` に FAQ の内容に合った質問を設定する\n3. 変数 `apiKey` に検索 API のキーを設定する\n4. コレクション全体を Run する\n\nCLI から実行する場合:\n  npx newman run postman/gc-rag-engine.postman_collection.json \\\n    --env-var baseUrl=https://your-service-url \\\n    --env-var query='<検索したい質問>' \\\n    --env-var apiKey='<検索 API のキー>'",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "",
      "type": "string",
      "description": "Cloud Run のサービス URL (末尾のスラッシュなし)"
    },
    {
      "key": "query",
      "value": "",
      "type": "string",
      "description": "正常系で投げる質問。FAQ の内容に合わせて設定してください"
    },
    {
      "key": "maxReferences",
      "value": "3",
      "type": "string",
      "description": "デプロイ側の ANSWER_MAX_REFERENCES と揃えてください"
    },
    {
      "key": "maxAnswerLength",
      "value": "",
      "type": "string",
      "description": "SEARCH_PREAMBLE で長さを指示している場合のみ設定。空なら長さを検証しません"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "検索 API のキー (SEARCH_API_KEYS のいずれか)。認証なしで公開している場合は空のまま"
    }
  ],
  "item": [
    {
      "name": "疎通確認",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "ヘルスチェック。Cloud Scheduler による keep-warm もこのエンドポイントを叩く。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 が返る', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('status が ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "",
                  "// 検索を含まないので、純粋な API 往復のレイテンシとして記録する。",
                  "// なおこのリクエストがインスタンスを起こすため、後続の /search には",
                  "// コールドスタート分は含まれない。",
                  "console.log('health responseTime:', pm.response.responseTime, 'ms');",
                  "pm.collectionVariables.set('healthMs', pm.response.responseTime);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "後方互換で残しているルート。プレーンテキストを返す。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 が返る', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('起動メッセージを返す', function () {",
                  "    pm.expect(pm.response.text()).to.include('RAG Engine Service is running');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "検索 (正常系)",
      "item": [
        {
          "name": "POST /search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "検索 API の共有シークレット"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": {{queryJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "Function Calling / 音声応答システムからの本番想定リクエスト。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 が返る', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('answer が生成されている', function () {",
                  "    pm.expect(",
                  "        body.answer,",
                  "        'answer が null です。アプリの LLM アドオン (SEARCH_ADD_ON_LLM) が有効か確認してください'",
                  "    ).to.be.a('string');",
                  "    pm.expect(body.answer.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('references が {title, link} の配列', function () {",
                  "    pm.expect(body.references).to.be.an('array');",
                  "    body.references.forEach(function (ref) {",
                  "        pm.expect(ref).to.have.property('title');",
                  "        pm.expect(ref).to.have.property('link');",
                  "    });",
                  "});",
                  "",
                  "// ANSWER_MAX_REFERENCES は設定可能なので、固定値ではなく変数と突き合わせる",
                  "pm.test('references が maxReferences 以内', function () {",
                  "    const max = Number(pm.variables.get('maxReferences'));",
                  "    pm.expect(body.references.length).to.be.at.most(Number.isFinite(max) ? max : 3);",
                  "});",
                  "",
                  "pm.test('relatedQuestions が配列', function () {",
                  "    pm.expect(body.relatedQuestions).to.be.an('array');",
                  "});",
                  "",
                  "// 回答の長さは SEARCH_PREAMBLE で指示している場合にしか保証されない。",
                  "// 未設定のデプロイではモデル既定のスタイルになるため、変数がある場合だけ検証する。",
                  "const maxAnswerLength = Number(pm.variables.get('maxAnswerLength'));",
                  "if (Number.isFinite(maxAnswerLength) && maxAnswerLength > 0) {",
                  "    pm.test(`回答が ${maxAnswerLength} 文字以内`, function () {",
                  "        pm.expect(body.answer.length).to.be.at.most(maxAnswerLength);",
                  "    });",
                  "}",
                  "",
                  "// health との差は「検索 + 回答生成」の実時間の目安。",
                  "// /health が先にインスタンスを起こすため、コールドスタートの指標にはならない。",
                  "// コールドスタートは Cloud Run のログの coldStart / clientInitMs で確認する。",
                  "const healthMs = Number(pm.collectionVariables.get('healthMs') || 0);",
                  "console.log('search responseTime:', pm.response.responseTime, 'ms',",
                  "            '(health との差:', pm.response.responseTime - healthMs, 'ms)');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /search?q=",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "検索 API の共有シークレット"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search?q={{query}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                }
              ]
            },
            "description": "GET でも POST と同じ結果を返すことの確認。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 が返る', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('POST と同じ形のレスポンス', function () {",
                  "    pm.expect(body).to.have.property('answer');",
                  "    pm.expect(body).to.have.property('references');",
                  "    pm.expect(body).to.have.property('relatedQuestions');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "検索 (異常系)",
      "item": [
        {
          "name": "POST /search (q なし)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "検索 API の共有シークレット"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 が返る', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('error が Bad Request', function () {",
                  "    pm.expect(pm.response.json().error).to.eql('Bad Request');",
                  "});",
                  "",
                  "pm.test('body 用のメッセージが返る', function () {",
                  "    pm.expect(pm.response.json().details).to.include('Body parameter');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /search (q が空白のみ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "検索 API の共有シークレット"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            },
            "description": "空白だけの質問を検索に流さないことの確認。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 が返る', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /search (q なし)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "description": "検索 API の共有シークレット"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 が返る', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('query 用のメッセージが返る', function () {",
                  "    pm.expect(pm.response.json().details).to.include('Query parameter');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /not-found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/not-found",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "not-found"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 が返る', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /search (認証なし)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q={{query}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                }
              ]
            },
            "description": "X-API-Key を付けずに叩き、認証が効いていることを確認する。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// apiKey が設定されていないデプロイ (ALLOW_UNAUTHENTICATED=true) では",
                  "// 認証が無効なので、401 ではなく通常のレスポンスが返る。",
                  "const authEnabled = Boolean(pm.variables.get('apiKey'));",
                  "",
                  "if (authEnabled) {",
                  "    pm.test('401 が返る', function () {",
                  "        pm.response.to.have.status(401);",
                  "    });",
                  "    pm.test('error が Unauthorized', function () {",
                  "        pm.expect(pm.response.json().error).to.eql('Unauthorized');",
                  "    });",
                  "} else {",
                  "    pm.test('認証が無効なので 200 が返る', function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// --env-var は environment スコープに入るため、全スコープを横断して解決する",
          "// pm.variables を使う (pm.collectionVariables では newman 実行時に見えない)",
          "for (const name of ['baseUrl', 'query']) {",
          "    if (!pm.variables.get(name)) {",
          "        throw new Error(`変数 ${name} を設定してください`);",
          "    }",
          "}",
          "",
          "// query を JSON リテラルとして埋め込めるようにしておく。",
          "// 生のまま {\"q\": \"{{query}}\"} に差し込むと、引用符や改行を含む質問で",
          "// JSON が壊れてリクエスト自体が送れなくなる。",
          "pm.collectionVariables.set('queryJson', JSON.stringify(pm.variables.get('query')));"
        ]
      }
    }
  ]
}
